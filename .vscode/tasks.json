{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run examples (poetry)",
            "type": "shell",
            "command": "poetry install; poetry run python3 src/main.py"
        },
        {
            "label": "pre-commit",
            "type": "shell",
            "command": "poetry install; poetry run pre-commit run --all-files --show-diff-on-failure"
        },
    ]
}
